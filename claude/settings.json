{
  "cleanupPeriodDays": 3650,
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "MAX_THINKING_TOKENS": "128000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(basename *)",
      "Bash(brew --prefix*)",
      "Bash(brew config)",
      "Bash(brew info *)",
      "Bash(brew list*)",
      "Bash(brew search *)",
      "Bash(cat *)",
      "Bash(command -v *)",
      "Bash(date*)",
      "Bash(df *)",
      "Bash(diff *)",
      "Bash(dirname *)",
      "Bash(du *)",
      "Bash(echo *)",
      "Bash(env)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(git blame *)",
      "Bash(git branch*)",
      "Bash(git config --get *)",
      "Bash(git describe*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git ls-files*)",
      "Bash(git remote*)",
      "Bash(git rev-parse *)",
      "Bash(git shortlog*)",
      "Bash(git show *)",
      "Bash(git stash list*)",
      "Bash(git status*)",
      "Bash(git tag*)",
      "Bash(head *)",
      "Bash(hostname)",
      "Bash(id)",
      "Bash(ls *)",
      "Bash(man *)",
      "Bash(printenv*)",
      "Bash(ps*)",
      "Bash(pwd)",
      "Bash(readlink *)",
      "Bash(realpath *)",
      "Bash(stat *)",
      "Bash(sw_vers*)",
      "Bash(tail *)",
      "Bash(tree *)",
      "Bash(type *)",
      "Bash(uname*)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(whoami)"
    ],
    "deny": [
      "Bash(chmod -R 777 *)",
      "Bash(dd *)",
      "Bash(diskutil eraseDisk *)",
      "Bash(diskutil partitionDisk *)",
      "Bash(git branch -D *)",
      "Bash(git clean -f*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(defaults delete *)",
      "Bash(defaults write *)",
      "Bash(launchctl *)",
      "Bash(mkfs *)",
      "Bash(networksetup *)",
      "Bash(osascript *)",
      "Bash(reboot*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(shutdown*)",
      "Bash(sudo *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "grep -o '\"file_path\":\"[^\"]*\"' | cut -d'\"' -f4 | { read -r f; case \"$f\" in *.sh|*bashrc|*bash_profile|*bash_prompt) bash -n \"$f\" && echo \"✓ syntax ok: $f\" ;; esac; }",
            "statusMessage": "Checking shell syntax…"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.githubusercontent.com",
        "formulae.brew.sh",
        "*.brew.sh",
        "ghcr.io"
      ]
    },
    "filesystem": {
      "denyWrite": [
        "~/.bashrc",
        "~/.zshrc",
        "~/.bash_profile",
        "/etc"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.config/gcloud",
        "~/.boto",
        "~/.config/configstore",
        "~/.npmrc",
        "~/.aws",
        "~/.gnupg",
        "~/.config/firebase",
        "~/.wrangler",
        "~/.cloudflared"
      ]
    },
    "excludedCommands": [
      "docker *",
      "docker-compose *"
    ]
  },
  "tui": "fullscreen",
  "voiceEnabled": true,
  "voice": {
    "enabled": true,
    "mode": "hold"
  }
}
